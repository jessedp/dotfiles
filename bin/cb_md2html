#!/usr/bin/env python3
"""
cb_md2html: Convert between Markdown and Gmail-style Rich HTML on the clipboard.

The direction is guessed from the input:
  - rich HTML on the clipboard (copied from Gmail / a browser), or HTML source
    as text, is converted to Markdown and put on the clipboard as plain text;
  - anything else (plain text, or an editor's syntax-highlighted copy) is
    treated as Markdown and put on the clipboard as Rich HTML.
So pressing the shortcut twice toggles back and forth.

Usage:
  cb_md2html               # clipboard -> clipboard, direction guessed
  cb_md2html file.md       # file (.md or .html) -> clipboard
  cat file.md | cb_md2html # stdin -> clipboard
  cb_md2html --to-md|--to-html [file|-]   # force the direction
"""

import sys
import os
import shutil
import subprocess
import re

PANDOC_BIN = shutil.which("pandoc") or "/home/jesse/.local/bin/pandoc"

def is_interactive():
    # Only print status messages when executed interactively from a terminal TTY
    return sys.stdout.isatty() and bool(os.environ.get("TERM"))

def log_msg(msg):
    if is_interactive():
        print(msg)
    elif shutil.which("notify-send"):
        # No terminal (e.g. a GNOME keyboard shortcut): say it on the desktop instead
        subprocess.run(["notify-send", "-t", "2000", "cb_md2html", msg])

def clipboard_types():
    if shutil.which("xclip"):
        p = subprocess.run(["xclip", "-selection", "clipboard", "-o", "-t", "TARGETS"], capture_output=True, text=True)
        if p.returncode == 0:
            return p.stdout.split()
    if shutil.which("wl-paste"):
        p = subprocess.run(["wl-paste", "--list-types"], capture_output=True, text=True)
        if p.returncode == 0:
            return p.stdout.split()
    return []

def clipboard_get(target=None):
    if shutil.which("xclip"):
        cmd = ["xclip", "-selection", "clipboard", "-o"] + (["-t", target] if target else [])
    elif shutil.which("wl-paste"):
        cmd = ["wl-paste"] + (["-t", target] if target else [])
    else:
        return ""
    p = subprocess.run(cmd, capture_output=True, text=True)
    return p.stdout if p.returncode == 0 else ""

def looks_like_html(text):
    return re.match(r"\s*<(!doctype|html|meta|div|p|span|table|ul|ol|b|h[1-6])\b", text, re.I) is not None

def is_editor_copy(html):
    # VS Code & co. put syntax-highlighted HTML on the clipboard alongside the
    # plain text: a monospace/pre-formatted block with no document structure.
    # That is Markdown source, not rich text.
    head = html[:1000].lower()
    if "white-space: pre" in head or "white-space:pre" in head or "monospace" in head:
        return not re.search(r"<(b|strong|i|em|ul|ol|table|blockquote|a|h[1-6])\b", html, re.I)
    return False

def get_input(path=None):
    """Return (text, kind) where kind is "md", "html" or None (unknown)."""
    if path and path != "-":
        with open(path, "r", encoding="utf-8") as f:
            text = f.read()
        if path.lower().endswith((".html", ".htm")):
            return text, "html"
        return text, None
    if path == "-" or not sys.stdin.isatty():
        # A keyboard shortcut runs us with stdin on /dev/null: empty stdin means
        # "use the clipboard", not "convert nothing".
        text = sys.stdin.read()
        if text.strip():
            return text, None

    types = clipboard_types()
    plain = ""
    for target in ["UTF8_STRING", "text/plain;charset=utf-8", "text/plain", "STRING"]:
        if target in types:
            plain = clipboard_get(target)
            if plain.strip():
                break
    if "text/html" in types:
        html = clipboard_get("text/html")
        if html.strip() and not (plain.strip() and is_editor_copy(html)):
            return html, "html"
    if not plain.strip():
        plain = clipboard_get()
    return plain, None

def convert_md_to_html(md_text):
    p = subprocess.run([PANDOC_BIN, "-f", "markdown+hard_line_breaks", "-t", "html", "--wrap=none"], input=md_text, capture_output=True, text=True)
    if p.returncode != 0:
        log_msg(f"Pandoc error: {p.stderr}")
        sys.exit(1)
    return p.stdout

def inject_compact_thin_border_styles(html):
    # Gmail has no table tool, so keep tables as plain as body text: inherited
    # font/size/weight, only a thin border in Gmail's quote-bar grey.
    cell = "border:1px solid rgb(204,204,204);padding:2px 6px;text-align:left;font-weight:normal"
    html = re.sub(r"<table\b[^>]*>", '<table style="border-collapse:collapse">', html)
    html = re.sub(r"<th(\s[^>]*)?>", f'<th style="{cell}">', html)
    html = re.sub(r"<td(\s[^>]*)?>", f'<td style="{cell}">', html)
    return html

TEXT_BLOCKS = ("p", "pre", "h1", "h2", "h3", "h4", "h5", "h6")
GMAIL_QUOTE_STYLE = "margin:0px 0px 0px 0.8ex;border-left:1px solid rgb(204,204,204);padding-left:1ex"

def gmailify(html):
    # Rewrite pandoc HTML into the markup Gmail's compose box itself produces
    # (see a "Show original" of a hand-typed message): one <div> per typed line,
    # <div><br></div> for an empty line, lists wrapped in a bare <div>, quote text
    # directly inside a gmail_quote blockquote, no whitespace between tags.
    from bs4 import BeautifulSoup, NavigableString
    soup = BeautifulSoup(html, "html.parser")

    def blank():
        d = soup.new_tag("div")
        d.append(soup.new_tag("br"))
        return d

    for ws in soup.find_all(string=lambda t: not t.strip() and t.parent.name != "pre"):
        ws.extract()

    # A blank line in the Markdown between two plain-text blocks becomes an empty
    # line in Gmail; lists, quotes and tables sit flush, as in the compose box.
    prev = None
    for c in list(soup.contents):
        if prev is not None and prev.name in TEXT_BLOCKS and c.name in TEXT_BLOCKS:
            c.insert_before(blank())
        prev = c

    for tag, gmail in (("strong", "b"), ("em", "i"), ("del", "strike")):
        for el in soup.find_all(tag):
            el.name = gmail
    for span in soup.find_all("span", class_="underline"):
        span.name = "u"
        span.attrs = {}

    # Gmail has no code formatting: inline code is plain text, a code block is
    # one <div> per line with its indentation kept.
    for code in soup.find_all("code"):
        if code.parent and code.parent.name == "pre":
            continue
        code.unwrap()

    for pre in soup.find_all("pre"):
        divs = []
        for line in pre.get_text().rstrip("\n").split("\n"):
            d = soup.new_tag("div")
            stripped = line.lstrip(" ")
            if stripped:
                d.append(NavigableString("\u00a0" * (len(line) - len(stripped)) + stripped))
            else:
                d.append(soup.new_tag("br"))
            divs.append(d)
        pre.replace_with(*divs)

    for h in soup.find_all(["h1", "h2", "h3", "h4", "h5", "h6"]):
        b = soup.new_tag("b")
        for c in list(h.contents):
            b.append(c.extract())
        h.attrs = {}
        if h.name in ("h1", "h2"):
            font = soup.new_tag("font", size="4")
            font.append(b)
            h.append(font)
        else:
            h.append(b)
        h.name = "div"

    # Each source line of a paragraph (hard_line_breaks) becomes its own <div>.
    for p in soup.find_all("p"):
        lines, cur = [], []
        for c in list(p.contents):
            if c.name == "br":
                lines.append(cur)
                cur = []
            else:
                cur.append(c.extract())
        lines.append(cur)
        if p.parent.name in ("li", "blockquote") and len(lines) == 1:
            p.replace_with(*lines[0])
            continue
        divs = []
        for line in lines:
            if line and isinstance(line[0], NavigableString):
                line[0] = NavigableString(line[0].lstrip("\n"))
            d = soup.new_tag("div")
            for c in line:
                d.append(c)
            if not line:
                d.append(soup.new_tag("br"))
            divs.append(d)
        p.replace_with(*divs)

    for bq in soup.find_all("blockquote"):
        bq.attrs = {"class": "gmail_quote", "style": GMAIL_QUOTE_STYLE}
        if len(bq.contents) == 1 and bq.contents[0].name == "div":
            bq.contents[0].unwrap()

    for lst in soup.find_all(["ul", "ol"]):
        lst.attrs = {}
        if lst.parent.name != "li":
            lst.wrap(soup.new_tag("div"))

    wrapper = soup.new_tag("div", dir="ltr")
    for c in list(soup.contents):
        wrapper.append(c.extract())
    return wrapper.decode(formatter="html5")

BLOCK_TAGS = {"div", "p", "ul", "ol", "table", "blockquote", "pre", "hr",
              "h1", "h2", "h3", "h4", "h5", "h6"}

def degmailify(html):
    # Undo Gmail's compose markup (see gmailify) so pandoc sees paragraphs: a run
    # of one-line <div>s becomes one <p> joined by <br>, <div><br></div> ends it.
    from bs4 import BeautifulSoup, NavigableString
    soup = BeautifulSoup(html, "html.parser")
    for el in soup.find_all(["meta", "style", "script", "title"]):
        el.decompose()

    def is_block(el):
        return getattr(el, "name", None) in BLOCK_TAGS

    def is_line_div(el):
        return el.name == "div" and not any(is_block(d) for d in el.find_all(True))

    def is_blank(el):
        return not el.get_text().replace("\u00a0", "").strip() and not el.find("img")

    def regroup(container):
        runs, cur, line = [], [], []

        def end_line():
            if line:
                cur.append(list(line))
                line.clear()

        def end_run():
            end_line()
            if cur:
                runs.append(list(cur))
                cur.clear()

        for c in list(container.contents):
            if isinstance(c, NavigableString) or not is_block(c):
                line.append(c)
            elif is_line_div(c):
                end_line()
                if is_blank(c):
                    end_run()
                    c.decompose()
                else:
                    cur.append([c])
            else:
                end_run()
                if c.name in ("div", "blockquote"):
                    regroup(c)
                runs.append(c)
        end_run()

        for r in runs:
            if not isinstance(r, list):
                continue
            p = soup.new_tag("p")
            first = r[0][0]
            first.insert_before(p)
            for i, line_nodes in enumerate(r):
                if i:
                    p.append(soup.new_tag("br"))
                for n in line_nodes:
                    n = n.extract()
                    if getattr(n, "name", None) == "div":
                        for k in list(n.contents):
                            p.append(k.extract())
                        n.decompose()
                    else:
                        p.append(n)

    for ws in soup.find_all(string=lambda t: not t.strip()):
        if ws.parent.name != "pre" and not ws.parent.find_parent("pre"):
            ws.extract()
    regroup(soup)
    return str(soup)

def convert_html_to_md(html):
    p = subprocess.run([PANDOC_BIN, "-f", "html", "-t", "gfm+hard_line_breaks-raw_html", "--wrap=none"],
                       input=degmailify(html), capture_output=True, text=True)
    if p.returncode != 0:
        log_msg(f"Pandoc error: {p.stderr}")
        sys.exit(1)
    # Gmail indents with &nbsp;; in a .md file that should just be spaces.
    return p.stdout.replace("\u00a0", " ")

def set_clipboard_text(text):
    if shutil.which("xclip"):
        p = subprocess.Popen(["xclip", "-selection", "clipboard"], stdin=subprocess.PIPE)
        p.communicate(input=text.encode("utf-8"))
    elif shutil.which("wl-copy"):
        subprocess.run(["wl-copy"], input=text, text=True)

def set_clipboard_html(html_str):
    if shutil.which("xclip"):
        p = subprocess.Popen(["xclip", "-selection", "clipboard", "-t", "text/html"], stdin=subprocess.PIPE)
        p.communicate(input=html_str.encode("utf-8"))
    elif shutil.which("wl-copy"):
        subprocess.run(["wl-copy", "-t", "text/html"], input=html_str, text=True)

def main():
    args = sys.argv[1:]
    force = None
    for flag, kind in (("--to-md", "html"), ("--to-html", "md")):
        if flag in args:
            args.remove(flag)
            force = kind

    text, kind = get_input(args[0] if args else None)
    if not text or not text.strip():
        log_msg("Notice: Clipboard or input was empty. Nothing converted.")
        return

    kind = force or kind or ("html" if looks_like_html(text) else "md")
    if kind == "html":
        set_clipboard_text(convert_html_to_md(text))
        log_msg("✓ Converted Rich HTML to Markdown on clipboard!")
    else:
        raw_html = convert_md_to_html(text)
        set_clipboard_html(gmailify(inject_compact_thin_border_styles(raw_html)))
        log_msg("✓ Converted Markdown to compact Rich HTML on clipboard!")

if __name__ == "__main__":
    main()
